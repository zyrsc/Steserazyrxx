import discord
from discord.ext import commands
import json
import os

# Bot yapılandırması (Prefix: !)
intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix="!", intents=intents)

# Varsayılan İngilizce help komutunu kaldırıyoruz ki kendi !yardim / !help komutumuz çalışsın
bot.remove_command('help')

DATA_FILE = "data.json"

# JSON Veritabanı Okuma ve Yazma Fonksiyonları
def data_oku():
    if not os.path.exists(DATA_FILE):
        return {"oyuncular": {}, "maclar": [], "kap_haberleri": []}
    with open(DATA_FILE, "r", encoding="utf-8") as f:
        return json.load(f)

def data_kaydet(data):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)

@bot.event
async def on_ready():
    print(f"🤖 {bot.user.name} başarıyla aktif oldu! Zeyrox League hazır.")

