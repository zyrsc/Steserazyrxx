# --- İŞLEVSEL KOMUTLAR ---

# 1. OYUNCU EKLE/GÜNCELLE
@bot.command()
@commands.has_permissions(administrator=True)
async def oyuncu_ekle(ctx, oyuncu_adi: str, takim: str, mevki: str, deger: str):
    data = data_oku()
    key = oyuncu_adi.lower()

    if key not in data["oyuncular"]:
        data["oyuncular"][key] = {
            "isim": oyuncu_adi,
            "takim": takim,
            "mevki": mevki,
            "deger": deger,
            "gol": 0,
            "asist": 0
        }
    else:
        data["oyuncular"][key]["takim"] = takim
        data["oyuncular"][key]["mevki"] = mevki
        data["oyuncular"][key]["deger"] = deger

    data_kaydet(data)
    await ctx.send(f"✅ **{oyuncu_adi}** adlı oyuncu **{takim}** kadrosuna eklendi/güncellendi!")

# 2. GOL EKLEME
@bot.command()
@commands.has_permissions(administrator=True)
async def gol(ctx, oyuncu_adi: str, miktar: int = 1):
    data = data_oku()
    key = oyuncu_adi.lower()

    if key in data["oyuncular"]:
        data["oyuncular"][key]["gol"] += miktar
        toplam_gol = data["oyuncular"][key]["gol"]
        gercek_isim = data["oyuncular"][key]["isim"]
        data_kaydet(data)
        await ctx.send(f"⚽ **{gercek_isim}** hesabına **+{miktar}** gol eklendi! (Toplam: {toplam_gol} Gol)")
    else:
        await ctx.send(f"❌ **{oyuncu_adi}** veritabanında bulunamadı! Önce `!oyuncu_ekle` komutu ile ekleyin.")

# 3. ASİST EKLEME
@bot.command()
@commands.has_permissions(administrator=True)
async def asist(ctx, oyuncu_adi: str, miktar: int = 1):
    data = data_oku()
    key = oyuncu_adi.lower()

    if key in data["oyuncular"]:
        data["oyuncular"][key]["asist"] += miktar
        toplam_asist = data["oyuncular"][key]["asist"]
        gercek_isim = data["oyuncular"][key]["isim"]
        data_kaydet(data)
        await ctx.send(f"🅰️ **{gercek_isim}** hesabına **+{miktar}** asist eklendi! (Toplam: {toplam_asist} Asist)")
    else:
        await ctx.send(f"❌ **{oyuncu_adi}** veritabanında bulunamadı!")

# 4. MAÇ GİRİŞİ
@bot.command()
@commands.has_permissions(administrator=True)
async def mac_gir(ctx, ev: str, skor: str, dep: str, hafta: int):
    data = data_oku()
    mac_verisi = {"hafta": hafta, "ev": ev, "skor": skor, "dep": dep}
    data["maclar"].append(mac_verisi)
    data_kaydet(data)
    await ctx.send(f"🏟️ **{hafta}. Hafta Maç Sonucu:** {ev} **{skor}** {dep} sisteme işlendi!")

# 5. TRANSFER & KAP BİLDİRİMİ
@bot.command()
@commands.has_permissions(administrator=True)
async def transfer(ctx, oyuncu_adi: str, eski: str, yeni: str, ucret: str):
    data = data_oku()
    key = oyuncu_adi.lower()

    if key in data["oyuncular"]:
        data["oyuncular"][key]["takim"] = yeni
        gercek_isim = data["oyuncular"][key]["isim"]
    else:
        gercek_isim = oyuncu_adi

    haber = f"🔄 RESMİ: {gercek_isim}, {ucret} karşılığında {eski} takımından {yeni} takımına transfer oldu!"
    data["kap_haberleri"].insert(0, haber)
    
    data_kaydet(data)
    await ctx.send(f"📢 **KAP BİLDİRİMİ:**\n{haber}")

# BOTU BAŞLAT
bot.run("DISCORD_BOT_TOKEN_BURAYA")

